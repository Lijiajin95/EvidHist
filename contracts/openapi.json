                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Readiness"
      }
    },
    "/v1/claims": {
      "get": {
        "operationId": "list_claims_endpoint_v1_claims_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ClaimSummaryOut"
                  },
                  "title": "Response List Claims Endpoint V1 Claims Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Claims Endpoint"
      },
      "post": {
        "description": "Create a claim; an exact-statement retry returns the stored claim with 200.",
        "operationId": "create_claim_endpoint_v1_claims_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClaimCreateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClaimCreatedOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Claim Endpoint"
      }
    },
    "/v1/claims/{claim_id}": {
      "get": {
        "operationId": "get_claim_endpoint_v1_claims__claim_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "claim_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Claim Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
