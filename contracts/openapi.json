{
  "components": {
    "schemas": {
      "Citation": {
        "additionalProperties": false,
        "properties": {
          "end": {
            "minimum": 0.0,
            "title": "End",
            "type": "integer"
          },
          "exact_quote": {
            "minLength": 1,
            "title": "Exact Quote",
            "type": "string"
          },
          "start": {
            "minimum": 0.0,
            "title": "Start",
            "type": "integer"
          },
          "version_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Version Id",
            "type": "string"
          }
        },
        "required": [
          "version_id",
          "start",
          "end",
          "exact_quote"
        ],
        "title": "Citation",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "Health",
        "type": "object"
      },
      "LocateQuoteRequest": {
        "additionalProperties": false,
        "properties": {
          "citation": {
            "$ref": "#/components/schemas/Citation"
          },
          "source": {
            "$ref": "#/components/schemas/TextVersion"
          }
        },
        "required": [
          "source",
          "citation"
        ],
        "title": "LocateQuoteRequest",
        "type": "object"
      },
      "QuoteLocation": {
        "additionalProperties": false,
        "description": "Offsets count Unicode code points and use an exclusive end.",
        "properties": {
          "end": {
            "minimum": 0.0,
            "title": "End",
            "type": "integer"
          },
          "exact_quote": {
            "minLength": 1,
            "title": "Exact Quote",
            "type": "string"
          },
          "start": {
            "minimum": 0.0,
            "title": "Start",
            "type": "integer"
          },
          "version_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Version Id",
            "type": "string"
          }
        },
        "required": [
          "version_id",
          "start",
          "end",
          "exact_quote"
        ],
        "title": "QuoteLocation",
        "type": "object"
      },
      "TextVersion": {
        "additionalProperties": false,
        "properties": {
          "text": {
            "minLength": 1,
            "title": "Text",
            "type": "string"
          },
          "version_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Version Id",
            "type": "string"
          }
        },
        "required": [
          "version_id",
          "text"
        ],
        "title": "TextVersion",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "EvidHist foundation",
    "version": "0.0.1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "liveness_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Liveness"
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "readiness_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Readiness"
      }
    },
    "/v1/quotes/locate": {
      "post": {
        "operationId": "locate_v1_quotes_locate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LocateQuoteRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QuoteLocation"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Locate"
      }
    }
  }
}
